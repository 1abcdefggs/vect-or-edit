{
  "name": "vect-or-edit",
  "version": "0.2.0",
  "description": "VectOrEditOr - Next-Generation Vector-based Semantic Knowledge Editor & Real-Time Linter",
  "keywords": [
    "electron",
    "editor",
    "markdown",
    "knowledge-base",
    "rust",
    "monaco-editor",
    "vector-search",
    "offline"
  ],
  "main": "out/main/index.js",
  "author": "1abcdefggs",
  "homepage": "https://github.com/1abcdefggs/vect-or-edit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/1abcdefggs/vect-or-edit.git"
  },
  "bugs": {
    "url": "https://github.com/1abcdefggs/vect-or-edit/issues"
  },
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "build:win": "electron-vite build && electron-builder --win",
    "dist": "electron-builder",
    "typecheck": "tsc --noEmit",
    "preview": "electron-vite preview",
    "test": "vitest run"
  },
  "dependencies": {
    "@1abcdefggs/vect-or-engine": "file:../vect-or-engine",
    "@huggingface/transformers": "^3.0.0",
    "monaco-editor": "^0.56.0"
  },
  "devDependencies": {
    "@electron/get": "^5.1.0",
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.3.0",
    "typescript": "^5.4.0",
    "vite": "^5.3.0",
    "vitest": "^1.6.0"
  },
  "build": {
    "appId": "com.vectoreditor.app",
    "productName": "VectOrEditOr",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/*.node"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "VectOrEditOr"
    }
  }
}
