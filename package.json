{
  "type": "module",
  "name": "vect-or-edit",
  "version": "0.3.7",
  "description": "VectOrEdit ,Next-Generation Vector-based Semantic Knowledge Editor & Real-Time Linter",
  "keywords": [
    "electron",
    "editor",
    "markdown",
    "monaco-editor",
    "knowledge-base",
    "vector-search",
    "semantic-search",
    "rust",
    "hnsw",
    "local-ai",
    "offline",
    "local-first"
  ],
  "main": "out/main/index.js",
  "author": "1abcdefggs",
  "homepage": "https://github.com/1abcdefggs/vect-or-edit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/1abcdefggs/vect-or-edit.git"
  },
  "bugs": {
    "url": "https://github.com/1abcdefggs/vect-or-edit/issues"
  },
  "license": "MIT",
  "scripts": {
    "clean": "node -e \"const fs=require('fs'); const cp=require('child_process'); try{cp.execSync('taskkill /F /IM electron.exe /T',{stdio:'ignore'});}catch(e){} ['dist','out','release','bin-release','build-dist','installer-release'].forEach(d => fs.rmSync(d, {recursive:true, force:true})); const appData=process.env.APPDATA ? require('path').join(process.env.APPDATA,'vect-or-edit') : ''; if(appData && fs.existsSync(appData)){fs.rmSync(appData, {recursive:true, force:true});}\"",
    "clear": "npm run clean",
    "prebuild": "npm run clean",
    "predev": "node -e \"const cp=require('child_process'); try{cp.execSync('taskkill /F /IM electron.exe /T',{stdio:'ignore'});}catch(e){}\"",
    "dev": "electron-vite dev",
    "dev:reset": "node -e \"const fs=require('fs'); const cp=require('child_process'); try{cp.execSync('taskkill /F /IM electron.exe /T',{stdio:'ignore'});}catch(e){} const appData=process.env.APPDATA ? require('path').join(process.env.APPDATA,'vect-or-edit') : ''; if(appData && fs.existsSync(appData)){fs.rmSync(appData, {recursive:true, force:true}); console.log('VectOrEdit development app data reset.');}\"",
    "build": "electron-vite build",
    "build:win": "electron-vite build && electron-builder --win",
    "dist": "electron-builder",
    "typecheck": "tsc --noEmit",
    "preview": "electron-vite preview",
    "test": "vitest run",
    "init:secret": "node scripts/init-secret.js",
    "postinstall": "npm run init:secret",
    "dev:debug": "electron-vite dev -- --inspect=5858 --remote-debugging-port=9222"
  },
  "dependencies": {
    "@1abcdefggs/vect-or-engine": "file:../vect-or-engine",
    "@google/genai": "^2.21.0",
    "@huggingface/transformers": "^3.0.0",
    "dotenv": "^16.4.5",
    "electron-updater": "^6.8.9",
    "hash-wasm": "^4.11.0",
    "monaco-editor": "^0.56.0"
  },
  "devDependencies": {
    "@electron/get": "^5.1.0",
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.3.0",
    "typescript": "^5.4.0",
    "vite": "^5.3.0",
    "vitest": "^1.6.0"
  },
  "build": {
    "appId": "com.vectoreditor.app",
    "productName": "VectOrEdit",
    "directories": {
      "output": "dist"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "1abcdefggs",
        "repo": "vect-or-edit"
      }
    ],
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/*.node"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "VectOrEdit",
      "differentialPackage": false
    }
  }
}