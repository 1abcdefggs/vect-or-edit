{
  "base": "vs",
  "inherit": true,
  "rules": [
    {
      "background": "FFFFFF",
      "token": ""
    },
    {
      "foreground": "756244",
      "fontStyle": "italic",
      "token": "comment"
    },
    {
      "foreground": "f39939",
      "token": "string"
    },
    {
      "foreground": "87abdb",
      "token": "constant"
    },
    {
      "foreground": "87abdb",
      "token": "keyword"
    },
    {
      "foreground": "111111",
      "fontStyle": "bold",
      "token": "entity.name"
    },
    {
      "foreground": "111111",
      "token": "variable"
    },
    {
      "foreground": "756244",
      "token": "punctuation"
    }
  ],
  "colors": {
    "editor.background": "#FFFFFF",
    "editor.foreground": "#111111",
    "editor.selectionBackground": "#ffe00960",
    "editor.lineHighlightBackground": "#ffe00920",
    "editorCursor.foreground": "#f39939",
    "editorLineNumber.foreground": "#87abdb",
    "editorWhitespace.foreground": "#75624440",
    "sideBar.background": "#fafafa",
    "titleBar.activeBackground": "#87abdb",
    "editorWidget.background": "#fafafa",
    "editorGroup.border": "#f0f0f0",
    "button.background": "#ffe009",
    "button.foreground": "#111111",
    "dropdown.background": "#fafafa",
    "dropdown.foreground": "#111111"
  }
